# ---- Secrets and credentials (never commit) ----
*.pem
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*
*_rsa
*_ed25519
.env
.env.*
*.token
*.secret
.netrc

# cloud / infra credentials
.aws/
.ssh/
**/credentials
**/*credentials*
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.kube/config
.config/gh/hosts.yml

# ---- Shell history / local-only state ----
.bash_history
.zsh_history
.python_history
.lesshst
.wget-hsts
*.log

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ---- Local overrides (keep machine-specific bits out of git) ----
*.local
local/
