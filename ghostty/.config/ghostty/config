# Ghostty config (macOS). Location: ~/.config/ghostty/config
# WSL has no Ghostty, so this package is only stowed on the Mac.

font-family = "BlexMono Nerd Font"
font-style = SemiBold
font-size = 14

theme = everforest-soft

# a little breathing room around the text
window-padding-x = 8
window-padding-y = 6

# sensible defaults
mouse-hide-while-typing = true
copy-on-select = clipboard
macos-option-as-alt = true

cursor-style = block
font-thicken = false

# translucent, blurred background for depth (the "rice" vibe)
background-opacity = 0.8
background-blur-radius = 20
