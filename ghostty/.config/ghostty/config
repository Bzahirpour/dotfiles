# Ghostty config (macOS). Location: ~/.config/ghostty/config
# WSL has no Ghostty, so this package is only stowed on the Mac.

font-family = "JetBrainsMono Nerd Font"
font-size = 14

theme = tokyonight

# a little breathing room around the text
window-padding-x = 8
window-padding-y = 6

# sensible defaults
mouse-hide-while-typing = true
copy-on-select = clipboard
macos-option-as-alt = true
